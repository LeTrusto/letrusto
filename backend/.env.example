APP_NAME=LeTrusto Backend
APP_ENV=production
API_V1_PREFIX=/api/v1

# PostgreSQL — use Railway's DATABASE_URL (set automatically if Railway PostgreSQL plugin is added)
DATABASE_URL=postgresql+pg8000://user:password@host:5432/dbname

# JWT — generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=https://letrusto.com,https://www.letrusto.com,https://letrusto.vercel.app

# Support email delivery (Resend)
RESEND_API_KEY=
SUPPORT_EMAIL=hello@letrusto.com
FROM_EMAIL=support@letrusto.com

# AI provider (heuristic = no external API needed)
AI_PROVIDER=heuristic
AI_SESSION_TTL_MINUTES=120

# Rate limiting (requests per minute per IP)
RATE_LIMIT_AUTH=10
RATE_LIMIT_DEFAULT=120

# Google OAuth (optional — leave empty if not using)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
